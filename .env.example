PORT=3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLAIM_SECRET=
BASE_RPC_URL=
BASE_RPC_FALLBACK_URL=
CK_ONCHAIN_MIN_CONFIRMATIONS=2
# Marketplace amounts use USDC atomic units (6 decimals). 1000 bps = 10%.
MARKETPLACE_FEE_BPS=1000
MARKETPLACE_FILE=./data/marketplace.json
# Private files, never commit. Auth contains expiring principal token hashes.
MARKETPLACE_AUTH_FILE=
# Operator-controlled capability-to-adapter bindings; never accept manifests as file access.
MARKETPLACE_ADAPTERS_FILE=
MARKETPLACE_ASSET_ROOT=
# Existing machine-commerce configuration, unchanged receiver-only behavior.
MACHINE_COMMERCE_FILE=./data/machine_commerce.json
CK_KENNEKARTE_HMAC_SECRET=
CK_ENABLE_MAINNET=false
X402_FACILITATOR_URL=https://x402.org/facilitator
PUBLIC_BASE_URL=http://localhost:3000
